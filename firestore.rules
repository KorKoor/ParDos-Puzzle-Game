rules_version = '2';

// ParDos — reglas de Firestore (v3)
//
// Publicarlas (desde la carpeta del proyecto, con el CLI de Firebase iniciado en tu cuenta):
//   firebase deploy --only firestore:rules --project pardos-b9b21
// Para volver atrás: Firebase Console > Firestore > Reglas > Historial > restaurar la versión anterior.
// Hasta ahora solo estaban publicadas las reglas abiertas de `users` y `user_progression`.
//
// Qué hacen:
//  - `players/{uid}` (cuentas de Google, app v3): solo el dueño escribe; cualquier jugador con sesión
//    puede leer el perfil público (necesario para amigos y ranking). Las consultas deben llevar `limit(10)` o menos
//    (la app ya lo hace): así nadie puede barrer la colección y gastar la cuota de lecturas.
//  - `trades/{id}` (intercambio de cartas repetidas entre amigos, v3): la crea el remitente, solo el destinatario
//    acepta o rechaza, solo el remitente cancela, y solo se puede cambiar el estado. Nadie puede borrarlas.
//  - `users` y `user_progression` (app publicada SIN cuenta): se mantienen abiertas para no romper a
//    quienes aún no actualizan, pero se PROHÍBE BORRAR. Cuando casi todos estén en la v3, se cierran.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Validación básica del perfil para frenar datos basura o abusivos
    function validProfile() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.playerLevel is int && d.playerLevel >= 1 && d.playerLevel <= 100000
        && (!('friendCode' in d) || (d.friendCode is string && d.friendCode.size() <= 8))
        && (!('friendsUids' in d) || (d.friendsUids is list && d.friendsUids.size() <= 300));
    }

    // ---- v3: perfiles con cuenta de Google ----
    match /players/{uid} {
      // Leer un perfil por id, o consultar con tope: nadie puede "listar toda la colección" (ni a propósito ni por error)
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 10;
      allow create, update: if isOwner(uid) && validProfile();
      allow delete: if isOwner(uid);
    }

    // ---- Intercambio de cartas repetidas entre amigos ----
    // Una propuesta la crea quien la envía; solo el destinatario puede aceptarla o rechazarla y solo el remitente cancelarla.
    // Los dos pueden leerla; nadie puede borrarla ni cambiar nada que no sea el estado.
    match /trades/{tradeId} {
      allow get: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow list: if signedIn() && request.query.limit <= 20
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'give', 'want', 'status', 'createdAt'])
        && request.resource.data.give is string && request.resource.data.give.size() <= 24
        && request.resource.data.want is string && request.resource.data.want.size() <= 24
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid;
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
        && ((resource.data.to == request.auth.uid && request.resource.data.status in ['accepted', 'declined'])
            || (resource.data.from == request.auth.uid && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }

    // ---- Legacy (app sin cuenta): abiertas, pero sin borrados ----
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /user_progression/{userId} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
